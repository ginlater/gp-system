<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIRECBleDemo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <!-- 冷启动窗口背景=暖玉柔光底（不再白屏）：Compose 还没绘制时就显示与 App 一致的米色，无缝过渡。 -->
        <item name="android:windowBackground">@color/meili_bg</item>
        <!-- 状态栏同米色 + 深色图标，避免冷启动一闪蓝色；运行时 enableEdgeToEdge 再接管。 -->
        <item name="android:statusBarColor">@color/meili_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
