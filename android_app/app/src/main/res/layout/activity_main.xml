<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- 未连接：居中显示连接按钮 -->
    <LinearLayout
        android:id="@+id/layout_connect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="开始蓝牙连接"
            android:textSize="16sp"
            android:backgroundTint="@color/colorPrimary" />

    </LinearLayout>

    <!-- 已连接：LinearLayout + weight 让 RecyclerView 独立滚动 -->
    <LinearLayout
        android:id="@+id/layout_connected"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 可滚动内容区域 -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 设备信息卡片 -->
            <LinearLayout
                android:id="@+id/layout_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/cardBg"
                android:layout_margin="12dp"
                android:elevation="2dp">

                <!-- 设备名 + 断开按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:text="AIREC" />

                    <Button
                        android:id="@+id/btn_disconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="断开连接"
                        android:textSize="12sp"
                        android:backgroundTint="#9E9E9E" />

                </LinearLayout>

                <!-- 电量 + 固件版本 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tv_battery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:text="电量：--" />

                    <TextView
                        android:id="@+id/tv_firmware"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary"
                        android:text="固件：--" />

                </LinearLayout>

                <!-- 存储 -->
                <TextView
                    android:id="@+id/tv_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:text="存储：--" />

                <!-- OTA 升级按钮 -->
                <Button
                    android:id="@+id/btn_ota"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:text="OTA 固件升级"
                    android:textSize="13sp"
                    android:backgroundTint="@color/colorAccent" />

                <!-- SN / MAC -->
                <TextView
                    android:id="@+id/tv_mac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:text="SN：--" />

                <!-- 分隔线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:text="⚙️ 设备设置" />

                <!-- 开关行：LED + USB -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_led"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="录音状态灯"
                        android:textSize="13sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_usb"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="USB开关"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 开关行：开机录音 + 自动传输 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_power_on_rec"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="开机录音"
                        android:textSize="13sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_auto_transfer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="自动传输"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 开关行：分贝检测 + 按键启动 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_decibel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="分贝检测"
                        android:textSize="13sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_key_start"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="按键启动"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 选择器行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分段录音："
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/btn_segment"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="不分段"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        style="?android:attr/borderlessButtonStyle" />
                    <View android:layout_width="16dp" android:layout_height="0dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="空闲关机："
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/btn_idle"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="不关机"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        style="?android:attr/borderlessButtonStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="麦克风增益："
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/btn_mic_gain"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="3"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        style="?android:attr/borderlessButtonStyle" />
                </LinearLayout>

                <!-- 安全码 / 激活码 / 格式化 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center">
                    <Button
                        android:id="@+id/btn_safe_code"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="安全码"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="@color/colorPrimary" />
                    <Button
                        android:id="@+id/btn_activate_code"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="激活码"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="@color/colorPrimary" />
                    <Button
                        android:id="@+id/btn_format"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:text="格式化"
                        android:textSize="12sp"
                        android:backgroundTint="#F44336" />
                </LinearLayout>

            </LinearLayout>

            <!-- 录音控制卡片 -->
            <LinearLayout
                android:id="@+id/layout_record_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/cardBg"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:gravity="center">

                <!-- 计时显示 -->
                <TextView
                    android:id="@+id/tv_record_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:text="00:00:00"
                    android:layout_marginBottom="8dp" />

                <!-- 实时转写开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实时转写"
                        android:textSize="13sp"
                        android:textColor="@color/textPrimary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_transcribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/tv_transcribe_lang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="中文"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>

                <!-- 实时转写状态提示 -->
                <TextView
                    android:id="@+id/tv_transcribe_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FF9800"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"
                    android:text="" />

                <!-- 实时转写结果区域 -->
                <ScrollView
                    android:id="@+id/scroll_transcribe"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="8dp"
                    android:background="#F5F5F5"
                    android:padding="8dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tv_transcribe_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:lineSpacingExtra="4dp"
                        android:text="" />
                </ScrollView>

                <!-- 分贝声波动画 -->
                <LinearLayout
                    android:id="@+id/layout_wave"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center|bottom"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp">
                    <View android:id="@+id/wave_bar_1" android:layout_width="4dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@color/colorPrimary" />
                    <View android:id="@+id/wave_bar_2" android:layout_width="4dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="@color/colorPrimary" />
                    <View android:id="@+id/wave_bar_3" android:layout_width="4dp" android:layout_height="20dp" android:layout_margin="2dp" android:background="@color/colorPrimary" />
                    <View android:id="@+id/wave_bar_4" android:layout_width="4dp" android:layout_height="30dp" android:layout_margin="2dp" android:background="@color/colorAccent" />
                    <View android:id="@+id/wave_bar_5" android:layout_width="4dp" android:layout_height="36dp" android:layout_margin="2dp" android:background="@color/colorAccent" />
                    <View android:id="@+id/wave_bar_6" android:layout_width="4dp" android:layout_height="30dp" android:layout_margin="2dp" android:background="@color/colorAccent" />
                    <View android:id="@+id/wave_bar_7" android:layout_width="4dp" android:layout_height="20dp" android:layout_margin="2dp" android:background="@color/colorPrimary" />
                    <View android:id="@+id/wave_bar_8" android:layout_width="4dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="@color/colorPrimary" />
                    <View android:id="@+id/wave_bar_9" android:layout_width="4dp" android:layout_height="8dp" android:layout_margin="2dp" android:background="@color/colorPrimary" />
                </LinearLayout>

                <!-- 录音控制按钮行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_start_record"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="开始录音"
                        android:textSize="14sp"
                        android:backgroundTint="@color/colorPrimary"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_pause_record"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="暂停"
                        android:textSize="14sp"
                        android:backgroundTint="@color/colorAccent"
                        android:layout_marginEnd="6dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btn_save_record"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="保存"
                        android:textSize="14sp"
                        android:backgroundTint="#4CAF50"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

            <!-- 文件列表区域 -->
            <LinearLayout
                android:id="@+id/layout_file_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp">

                <!-- 标题栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="0dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_file_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:text="设备文件" />

                    <Button
                        android:id="@+id/btn_refresh_files"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="刷新"
                        android:textSize="13sp"
                        android:backgroundTint="@color/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:text="← 左滑删除文件" />

                <!-- 音频文件列表 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_audio_header"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:paddingStart="8dp"
                        android:gravity="center_vertical"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@color/colorPrimary"
                        android:text="🎵 音频文件 (0)" />

                    <!-- 分类筛选 Tab -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_filter"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        app:tabMode="fixed"
                        app:tabGravity="fill"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</LinearLayout>